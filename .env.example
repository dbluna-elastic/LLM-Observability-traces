# --- LLM: LiteLLM proxy (default) → Presidio → OpenAI gpt-4o-mini ---
# Required for default model: real OpenAI key (LiteLLM and app both read this in Docker Compose).
OPENAI_API_BASE=http://litellm:4000
OPENAI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-openai-key-here

# Local-only / no OpenAI: use Ollama tinyllama (no OPENAI key needed on LiteLLM for that route).
# OPENAI_MODEL=tinyllama
# OPENAI_API_KEY=ollama

# Bypass LiteLLM; call Ollama directly (e.g. local dev):
# OPENAI_API_BASE=http://ollama:11434/v1

# Call OpenAI from the app without LiteLLM (no Presidio on that path unless you add it elsewhere):
# OPENAI_API_BASE=
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Ollama: model to pull on first start (when using Ollama behind LiteLLM or directly)
# OLLAMA_MODEL=tinyllama

# LiteLLM + Presidio (used by the litellm service in docker-compose; optional override)
# Presidio listens on 3000 inside Docker; host ports 5002/5001 are for local curl only.
# PRESIDIO_ANALYZER_API_BASE=http://presidio-analyzer:3000
# PRESIDIO_ANONYMIZER_API_BASE=http://presidio-anonymizer:3000

# Tool-calling agent (weather demo). Default true in docker-compose (agent_call in Traceflow). tinyllama often mangles tools—set false or use a capable model.
CHATBOT_USE_TOOLS=true

# Optional: override the default system instruction (short, concise replies). Leave unset for built-in brevity prompt.
# CHATBOT_SYSTEM_INSTRUCTION=Answer in one sentence only.

# Optional: Traceloop – prompt/completion capture and metrics enrichment (default: both true)
# TRACELOOP_TRACE_CONTENT=true
# TRACELOOP_ENRICH_TOKENS=true

# Optional: set true to send traceparent to LiteLLM so proxy spans appear in the same trace as handle_chat; default false (separate traces)
# PROPAGATE_TRACE_TO_LITELLM=false

# --- Elastic APM ---
# Required: Elastic APM Server URL (OTLP on port 8200). Examples:
#   Elastic Cloud: https://your-deployment.apm.region.elastic-cloud.com:443
#   Self-hosted:   https://your-apm-host:8200
ELASTIC_APM_SERVER_URL=https://your-elastic-apm:8200

# Optional: APM secret token (for Elastic Cloud / secured APM Server)
# ELASTIC_APM_SECRET_TOKEN=your-secret-token

# Optional: set to true for self-signed or dev TLS
# ELASTIC_APM_INSECURE=false

# Optional: service name and environment (environment appears in APM Service inventory)
# OTEL_SERVICE_NAME=chatbot-service
# SERVICE_ENVIRONMENT=chatbot
