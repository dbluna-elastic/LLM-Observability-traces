# --- LLM (default in docker-compose): Elastic LiteLLM prod ---
# Use the API key issued for your Elastic LiteLLM deployment. Match Elastic's OpenAI client example: host only (no /v1).
OPENAI_API_BASE=https://elastic.litellm-prod.ai
# Must match the full "id" from /v1/models (often prefixed), e.g. llm-gateway/gpt-4.1-mini — not bare gpt-4.1-mini.
#   EXPOSE_LLM_MODELS=true  →  GET http://localhost:8088/api/llm/models
#   or: curl -sS -H "Authorization: Bearer $OPENAI_API_KEY" "$OPENAI_API_BASE/v1/models"
OPENAI_MODEL=llm-gateway/gpt-4.1-mini
OPENAI_API_KEY=your-litellm-or-openai-key-here

# Optional: expose GET /api/llm/models (see above). Turn off in shared environments.
# EXPOSE_LLM_MODELS=true

# Optional: append raw upstream error snippet to chat error messages (local debugging).
# DEBUG_LLM_ERRORS=true

# Local stack: Presidio + LiteLLM in Docker + Ollama tinyllama (no cloud key for tinyllama path)
# OPENAI_API_BASE=http://litellm:4000
# OPENAI_MODEL=tinyllama
# OPENAI_API_KEY=ollama
# CHATBOT_USE_TOOLS=false

# Local LiteLLM with OpenAI-backed model (add model_name to litellm-config.yaml; key on litellm service too)
# OPENAI_API_BASE=http://litellm:4000
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=sk-...

# Bypass LiteLLM; call Ollama directly (e.g. local dev):
# OPENAI_API_BASE=http://ollama:11434/v1

# Tool-calling agent (weather demo). Use true with capable cloud models; false for tinyllama.
CHATBOT_USE_TOOLS=false
# Optional: set true to allow parallel tool_calls (OpenAI default). Default false = sequential tool rounds (better for some gateways).
# CHATBOT_PARALLEL_TOOL_CALLS=true

# Weather tool: open_meteo = live data via Open-Meteo (HTTPS, no API key); stub = fixed demo temps (offline/tests).
# WEATHER_PROVIDER=open_meteo

# POST /api/chat optional JSON field category: use-case label (see GET /api/prompt/categories). Omitted or blank → Other.
# DeepEval: score each /api/chat reply (answer relevancy, LLM-as-judge). Adds latency and uses OPENAI_API_KEY (+ OPENAI_API_BASE).
# DEEPEVAL_SCORE_CHAT=true
# When CHATBOT_USE_TOOLS=true and the agent calls tools, also run Task Completion (user goal vs outcome + tools). Default on; set false to save judge cost.
# DEEPEVAL_SCORE_AGENT=true
# Judge-only model (chat uses OPENAI_MODEL). Docker default: llm-gateway/gpt-4.1. Must be valid for OPENAI_API_BASE.
# Short names are auto-prefixed on Elastic hosted LiteLLM. Custom DeepEval judge sends the id verbatim.
# DEEPEVAL_JUDGE_MODEL=llm-gateway/gpt-4.1
# DEEPEVAL_INCLUDE_REASON=true
# DEEPEVAL_TELEMETRY_OPT_OUT=YES

# Optional: override the default system instruction (short, concise replies). Leave unset for built-in brevity prompt.
# CHATBOT_SYSTEM_INSTRUCTION=Answer in one sentence only.

# Optional: Traceloop – prompt/completion capture and metrics enrichment (default: both true)
# TRACELOOP_TRACE_CONTENT=true
# TRACELOOP_ENRICH_TOKENS=true

# Optional: set true to send traceparent to LiteLLM so proxy spans appear in the same trace as handle_chat; default false (separate traces)
# PROPAGATE_TRACE_TO_LITELLM=false

# Optional: append debug snippet to chat errors (local dev)
# DEBUG_LLM_ERRORS=true

# --- Elastic APM ---
# Required: Elastic APM Server URL (OTLP on port 8200). Examples:
#   Elastic Cloud: https://your-deployment.apm.region.elastic-cloud.com:443
#   Self-hosted:   https://your-apm-host:8200
ELASTIC_APM_SERVER_URL=https://your-elastic-apm:8200

# Optional: APM secret token (for Elastic Cloud / secured APM Server)
# ELASTIC_APM_SECRET_TOKEN=your-secret-token

# Optional: set to true for self-signed or dev TLS
# ELASTIC_APM_INSECURE=false

# Optional: service name and environment (environment appears in APM Service inventory)
# OTEL_SERVICE_NAME=chatbot-service
# SERVICE_ENVIRONMENT=chatbot
